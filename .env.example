# Groq LLM API Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database (Neon PostgreSQL connection string)
# Example: postgresql+psycopg://user:pass@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@hostname/database?sslmode=require

# External Search / Enrichment Provider API Settings (e.g. SerpAPI, Tavily, Google Custom Search)
# If left empty, backend falls back to built-in MockProvider for testing
SEARCH_API_KEY=your_search_api_key_here
SEARCH_API_URL=https://api.tavily.com/search

# Frontend -> Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
